# Copy to .env.local. Only Next.js auto-loads it; every script needs the
# `pnpm exec dotenv -e .env.local --` prefix (see CLAUDE.md).

# Supabase transaction pooler, port 6543 — NOT the session pooler on 5432.
# Drizzle runs with prepare:false because transaction-mode poolers cannot
# cache prepared statements.
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# Read by @anthropic-ai/sdk for the explainer (/api/explain, scripts/try-explain.ts).
ANTHROPIC_API_KEY=sk-ant-...

# Used by the collector in client/. AEGIS_KEY is printed once by
# scripts/bootstrap.ts and only its SHA-256 hash is stored server-side.
AEGIS_URL=http://localhost:3000
AEGIS_KEY=aegis_mk_...

# Optional. Defaults to the machine hostname / ~/.claude/projects.
# AEGIS_MACHINE=fedora
# AEGIS_PROJECTS_DIR=/home/you/.claude/projects
